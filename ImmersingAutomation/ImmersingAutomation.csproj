<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <TargetFramework>net10.0</TargetFramework>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>

        <!-- NuGet 包元数据 -->
        <PackageId>ImmersingAutomation</PackageId>
        <Version>0.1.0-beta.1</Version>
        <Authors>ImmersingEducation</Authors>
        <Company>ImmersingEducation</Company>
        <Description>基于触发器、规则集与可回滚动作的可扩展 .NET 工作流自动化引擎。</Description>
        <PackageTags>automation;workflow;triggers;rules;actions;dotnet</PackageTags>
        <PackageLicenseExpression>MIT</PackageLicenseExpression>
        <PackageReadmeFile>README.md</PackageReadmeFile>
        <RepositoryUrl>https://github.com/ImmersingEducation/ImmersingAutomation</RepositoryUrl>
        <RepositoryType>git</RepositoryType>
        <PublishRepositoryUrl>true</PublishRepositoryUrl>
        <PackageRequireLicenseAcceptance>false</PackageRequireLicenseAcceptance>

        <!-- 为使用方生成 XML 文档，并同时产出调试用符号包 -->
        <GenerateDocumentationFile>true</GenerateDocumentationFile>
        <IncludeSymbols>true</IncludeSymbols>
        <SymbolPackageFormat>snupkg</SymbolPackageFormat>
    </PropertyGroup>

    <ItemGroup>
      <None Include="..\README.md" Pack="true" PackagePath="\" Link="README.md" />
    </ItemGroup>

    <ItemGroup>
      <PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="10.0.14" />
      <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" Version="10.0.14" />
      <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" Version="10.0.14" />
    </ItemGroup>

</Project>
